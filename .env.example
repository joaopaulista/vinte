# Copie para .env e preencha. O .env está no .gitignore — nunca o versione.
#
# Estas variáveis vão para o bundle do navegador (prefixo VITE_), então só
# coloque aqui valores PÚBLICOS. A anon key é pública por design: quem protege
# os dados é a Row Level Security.
#
# NUNCA coloque aqui: SUPABASE_SERVICE_ROLE_KEY, PLUGGY_CLIENT_ID,
# PLUGGY_CLIENT_SECRET ou PLUGGY_WEBHOOK_SECRET. Esses vão em
# `npx supabase secrets set ...` (ver README).

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<sua-anon-key>

# Deixe false em produção para esconder os conectores de teste do Pluggy.
VITE_PLUGGY_INCLUDE_SANDBOX=true
